# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key. NUNCA la expongas al browser ni la prefijes con
# NEXT_PUBLIC_: salta RLS y todas las tablas del piloto estan cerradas.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Panel interno /admin (Basic Auth)
# ---------------------------------------------------------------------------
ADMIN_USER=dolfs
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# Protege /api/ingesta/worker y /api/cron/resync. Genera uno con:
#   openssl rand -hex 32
CRON_SECRET=

# Token con el que el servidor MCP llama a POST /api/handoffs.
# Si se deja vacio, ese endpoint acepta el CRON_SECRET.
MCP_API_KEY=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------
# Base publica para construir los enlaces de seguimiento /ir?h=...
# En Vercel se infiere sola; en local dejala en localhost.
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# User-Agent con el que el bot se identifica ante las tiendas. Tiene que
# llevar una URL de contacto real y alcanzable.
DOLFS_BOT_USER_AGENT=DolfsBot/0.1 (+https://dolfs.cl/bot; piloto; contacto@dolfs.cl)
